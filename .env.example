# Data Agent - Production Environment Configuration
# Copy this file to .env and fill in your values

# Server
DATA_AGENT_HOST=0.0.0.0
DATA_AGENT_PORT=8000
DATA_AGENT_AUTH=true
DATA_AGENT_API_KEY=your-secret-api-key-here

# Data source mode: mock (default, safe) | sqlite | sandbox (deterministic ecommerce fixture)
# Real enterprise connections are fail-closed and require explicit approval below.
DATA_AGENT_DB_MODE=mock
# Only set to true after sandbox integration gate + approvals are complete.
DATA_AGENT_APPROVE_REAL_CONNECTION=false

# Database (PostgreSQL for production)
DATA_AGENT_DB_TYPE=postgresql

DATA_AGENT_DB_HOST=localhost
DATA_AGENT_DB_PORT=5432
DATA_AGENT_DB_NAME=data_agent
DATA_AGENT_DB_USER=data_agent
DATA_AGENT_DB_PASSWORD=your-db-password-here
DATA_AGENT_DB_POOL_MIN=2
DATA_AGENT_DB_POOL_MAX=10

# LLM
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Observability
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# Cache
DATA_AGENT_CACHE_SIZE=1000
DATA_AGENT_CACHE_TTL=300

# Rate Limiting
DATA_AGENT_RATE_LIMIT=100

# Logging
DATA_AGENT_LOG_LEVEL=INFO
