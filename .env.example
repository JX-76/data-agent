# Data Agent local configuration template
# Copy this file to .env, then fill only the values you need:
#   Windows CMD: copy .env.example .env
#   PowerShell:  Copy-Item .env.example .env
# .env is ignored by Git. Never commit real API keys.

# Local server. Keep 127.0.0.1 for a personal/local install.
DATA_AGENT_HOST=127.0.0.1
DATA_AGENT_PORT=8000

# Optional: protect the local API. Use a newly generated value when enabling it.
# DATA_AGENT_AUTH=false
# DATA_AGENT_API_KEY=replace-with-your-own-local-api-key

# Optional model-provider fallback. These values are intentionally blank.
# You may either set them here OR configure them after startup through
# the web UI: "模型/API 设置". UI settings are saved only on the local machine
# in .data_agent_provider_config.json (also ignored by Git).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Safe local default data mode. Do not enable real data connections without
# reviewing the deployment and permission requirements.
DATA_AGENT_DB_MODE=mock
DATA_AGENT_APPROVE_REAL_CONNECTION=false

# Optional observability configuration; leave blank if unused.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

DATA_AGENT_CACHE_SIZE=1000
DATA_AGENT_CACHE_TTL=300
DATA_AGENT_RATE_LIMIT=100
DATA_AGENT_LOG_LEVEL=INFO
